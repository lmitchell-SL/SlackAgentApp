# Copy these names into Netlify: Site configuration > Environment variables.
# Never put real values in this file or in the code.

# --- Required ---
# Anthropic API key from the Console workspace that holds your agents.
ANTHROPIC_API_KEY=
# The whsec_... secret shown once when you create the Console webhook.
ANTHROPIC_WEBHOOK_SIGNING_KEY=
# Slack "Bot User OAuth Token" (starts with xoxb-).
SLACK_BOT_TOKEN=
# Slack "Signing Secret" (Basic Information page of the Slack app).
SLACK_SIGNING_SECRET=
# Comma-separated Slack channel IDs where the bot answers.
ALLOWED_CHANNEL_IDS=C0C6T53G5J4

# --- Optional ---
# Comma-separated Slack user IDs allowed to press Approve / Deny. Empty = anyone in the channel.
APPROVER_USER_IDS=
# Console workspace ID for session links. Leave empty for the "Default" workspace.
CONSOLE_WORKSPACE=
# Fallback environment and vaults when an agent has no earlier session to copy from.
DEFAULT_ENVIRONMENT_ID=
DEFAULT_VAULT_IDS=
# Per-agent settings as JSON, e.g. {"agent_abc":{"environment_id":"env_123","vault_ids":["vlt_1"]}}
AGENT_SETTINGS=
